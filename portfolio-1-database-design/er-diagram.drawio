target="c13" edge="1"><mxGeometry x="0" relative="1" as="geometry"><mxPoint y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;An arrow A &amp;rarr; B means tables in A hold foreign keys to tables in B. Within Customers &amp;amp; KYC, customer references kyc_tier and agent references its owning customer." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="40" y="540" width="1000" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tosipay-er" name="2. Full ER diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2550" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c22" value="&lt;b style=&quot;font-size:20px&quot;&gt;TosiPay - Entity Relationship Diagram&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#555555&quot;&gt;PK = primary key (&lt;b&gt;&lt;u&gt;bold, underlined&lt;/u&gt;&lt;/b&gt;) &amp;middot; FK = foreign key (&lt;i&gt;italic&lt;/i&gt;) &amp;middot; UK = unique &amp;middot; ? = nullable &amp;middot; * = composite key (account_type_code, owner_kind) &amp;middot; crow&amp;#39;s foot notation &amp;middot; solid line = identifying, dashed = non-identifying&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1600" height="60" as="geometry"/></mxCell><mxCell id="c23" value="kyc_tier" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" parent="1" vertex="1"><mxGeometry x="40" y="100" width="320" height="134" as="geometry"/></mxCell><mxCell id="c24" value="" style="sh